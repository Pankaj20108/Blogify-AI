# Server port
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/blogify

# Cloudinary (thumbnail uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: restrict CORS to your frontend URL (defaults to *)
# CLIENT_URL=http://localhost:5173
